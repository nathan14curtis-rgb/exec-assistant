{
  "name": "idea-capture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup-sheet": "tsx scripts/setup-sheet.ts",
    "migrate:sql": "tsx scripts/migrate-sheets-to-d1.ts",
    "d1:migrate": "wrangler d1 migrations apply idea-capture --remote",
    "d1:migrate:local": "wrangler d1 migrations apply idea-capture --local",
    "migrate:apply": "wrangler d1 execute idea-capture --remote --file=migrations/data/legacy-ideas.sql",
    "site:build": "node site/build.mjs",
    "site:dev": "npm run site:build && wrangler dev -c site/wrangler.toml",
    "site:deploy": "npm run site:build && wrangler deploy -c site/wrangler.toml",
    "preview": "tsx preview/render.ts preview/out.html"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@types/node": "^26.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.107.0"
  }
}
